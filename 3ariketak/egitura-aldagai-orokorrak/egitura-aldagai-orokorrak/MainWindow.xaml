<Window x:Class="egitura_aldagai_orokorrak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:egitura_aldagai_orokorrak"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="500">
    <Grid>
        <Label x:Name="lb_izena" Content="Izena:" HorizontalAlignment="Left" Height="36" Margin="26,39,0,0" VerticalAlignment="Top" Width="125" FontSize="16"/>
        <TextBox x:Name="tb_izena" HorizontalAlignment="Left" Height="36" Margin="171,39,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="283" FontSize="16"/>
        <Label x:Name="lb_abizena1" Content="1. Abizena:" HorizontalAlignment="Left" Height="36" Margin="26,105,0,0" VerticalAlignment="Top" Width="125" FontSize="16"/>
        <TextBox x:Name="tb_abizena1" HorizontalAlignment="Left" Height="36" Margin="171,105,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="283" FontSize="16"/>
        <Label x:Name="lb_abizena2" Content="2. Abizena" HorizontalAlignment="Left" Height="36" Margin="26,0,0,0" VerticalAlignment="Center" Width="125" FontSize="16"/>
        <TextBox x:Name="tb_abizena2" HorizontalAlignment="Left" Height="36" Margin="171,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Width="283" FontSize="16"/>
        <Label x:Name="lb_nan" Content="NAN:" HorizontalAlignment="Left" Height="36" Margin="26,240,0,0" VerticalAlignment="Top" Width="125" FontSize="16"/>
        <TextBox x:Name="tb_nan" HorizontalAlignment="Left" Height="36" Margin="171,240,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="283" FontSize="16"/>
        <Button x:Name="bt_onartu" Content="Onartu" HorizontalAlignment="Left" Height="34" Margin="26,306,0,0" VerticalAlignment="Top" Width="106" FontSize="20" Click="bt_onartu_Click"/>
        <Button x:Name="bt_kargatu" Content="Kargatu eta bistaratu" HorizontalAlignment="Left" Height="34" Margin="150,306,0,0" VerticalAlignment="Top" Width="220" FontSize="20" Click="bt_kargatu_Click"/>
        <Button x:Name="bt_irten" Content="Irten" HorizontalAlignment="Left" Height="34" Margin="387,306,0,0" VerticalAlignment="Top" Width="67" FontSize="20" Click="bt_irten_Click"/>

    </Grid>
</Window>
