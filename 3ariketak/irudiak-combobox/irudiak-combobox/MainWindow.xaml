<Window x:Class="irudiak_combobox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:irudiak_combobox"
        mc:Ignorable="d"
        Title="MainWindow" Height="460" Width="800">
    <Grid>
        <Label x:Name="lb_titulua" Content="NIRE IRUDIAK" HorizontalAlignment="Center" Height="57" Margin="0,22,0,0" VerticalAlignment="Top" Width="250" FontSize="36" FontWeight="Bold"/>
        <Label x:Name="lb_1ilara" Content="1. ilara" HorizontalAlignment="Left" Height="31" Margin="26,101,0,0" VerticalAlignment="Top" Width="120" FontSize="16"/>
        <Label x:Name="lb_2ilara" Content="2. ilara" HorizontalAlignment="Left" Height="31" Margin="26,264,0,0" VerticalAlignment="Top" Width="120" FontSize="16"/>
        <ComboBox x:Name="cb_irudiak" HorizontalAlignment="Left" Height="25" Margin="26,137,0,0" VerticalAlignment="Top" Width="152" SelectionChanged="ComboBox_SelectionChanged">
            <ComboBoxItem x:Name="cbi_1" Content="Irudia 1"/>
            <ComboBoxItem x:Name="cbi_2" Content="Irudia 2"/>
            <ComboBoxItem x:Name="cbi_3" Content="Irudia 3"/>
        </ComboBox>
        <CheckBox x:Name="cb_4" Content="Irudia 4" HorizontalAlignment="Left" Margin="26,301,0,0" VerticalAlignment="Top" FontSize="16" Height="22" Checked="cb_4_Checked" Unchecked="cb_4_Unchecked"/>
        <CheckBox x:Name="cb_5" Content="Irudia 5" HorizontalAlignment="Left" Margin="26,334,0,0" VerticalAlignment="Top" FontSize="16" Height="22" Checked="cb_5_Checked" Unchecked="cb_5_Unchecked"/>
        <CheckBox x:Name="cb_6" Content="Irudia 6" HorizontalAlignment="Left" Margin="26,368,0,0" VerticalAlignment="Top" FontSize="16" Height="22" Checked="cb_6_Checked" Unchecked="cb_6_Unchecked"/>
        <Button x:Name="bt_irten" Content="Irten" HorizontalAlignment="Left" Height="34" Margin="612,374,0,0" VerticalAlignment="Top" Width="126" FontSize="16" Click="bt_irten_Click"/>
        <Image x:Name="img_1" HorizontalAlignment="Left" Height="87" Margin="559,162,0,0" VerticalAlignment="Top" Width="100" Source="/images/1.png" Visibility="Hidden"/>
        <Image x:Name="img_2" HorizontalAlignment="Left" Height="87" Margin="559,162,0,0" VerticalAlignment="Top" Width="100" Source="/images/2.png" Visibility="Hidden"/>
        <Image x:Name="img_3" HorizontalAlignment="Left" Height="87" Margin="559,162,0,0" VerticalAlignment="Top" Width="100" Source="/images/3.png" Visibility="Hidden"/>
        <Image x:Name="img_4" HorizontalAlignment="Left" Height="100" Margin="257,264,0,0" VerticalAlignment="Top" Width="146" Source="/images/4.png" Visibility="Hidden"/>
        <Image x:Name="img_5" HorizontalAlignment="Left" Height="100" Margin="437,264,0,0" VerticalAlignment="Top" Width="146" Source="/images/5.png" Visibility="Hidden"/>
        <Image x:Name="img_6" HorizontalAlignment="Left" Height="100" Margin="621,264,0,0" VerticalAlignment="Top" Width="117" Source="/images/6.png" Visibility="Hidden"/>
    </Grid>
</Window>
