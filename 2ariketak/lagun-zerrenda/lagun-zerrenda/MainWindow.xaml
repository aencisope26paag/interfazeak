<Window x:Class="lagun_zerrenda.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lagun_zerrenda"
        mc:Ignorable="d"
        Title="Lagun-zerrenda" Height="650" Width="500">
    <Grid>
        <Label x:Name="lb_nire" Content="Nire lagunak" HorizontalAlignment="Left" Height="50" Margin="35,69,0,0" VerticalAlignment="Top" Width="161" FontSize="16"/>
        <ListBox x:Name="listbox_lagunak" HorizontalAlignment="Left" Height="232" Margin="35,124,0,0" VerticalAlignment="Top" Width="188" d:ItemsSource="{d:SampleData ItemCount=5}" FontSize="16"/>
        <Button x:Name="bt_gehitu" Content="Gehitu" HorizontalAlignment="Left" Height="42" Margin="306,146,0,0" VerticalAlignment="Top" Width="139" FontSize="16" Click="bt_gehitu_Click"/>
        <Button x:Name="bt_ezabatu" Content="Ezabatu" HorizontalAlignment="Left" Height="42" Margin="306,219,0,0" VerticalAlignment="Top" Width="139" FontSize="16" Click="bt_ezabatu_Click"/>
        <Button x:Name="bt_garbitu" Content="Zerrenda garbitu" HorizontalAlignment="Left" Height="42" Margin="306,0,0,0" VerticalAlignment="Center" Width="139" FontSize="16" Click="bt_garbitu_Click"/>
        <Label x:Name="lb_hautatu" Content="Hautatutako laguna" HorizontalAlignment="Left" Height="45" Margin="35,375,0,0" VerticalAlignment="Top" Width="161" FontSize="16"/>
        <TextBox x:Name="tb_hautatu" HorizontalAlignment="Left" Height="42" Margin="35,420,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="161" FontSize="16"/>
        <Label x:Name="lb_berria" Content="Lagun berria" HorizontalAlignment="Left" Height="44" Margin="35,486,0,0" VerticalAlignment="Top" Width="161" FontSize="16"/>
        <TextBox x:Name="tb_berria" HorizontalAlignment="Left" Height="42" Margin="35,535,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="161" FontSize="16"/>

    </Grid>
</Window>
